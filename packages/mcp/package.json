{
  "name": "kennel-mcp",
  "version": "0.1.0",
  "type": "module",
  "description": "stdio MCP server that proxies tool calls to a kennel HTTP API.",
  "license": "MIT",
  "bin": {
    "kennel-mcp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "import": "./dist/register.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@kennel/core": "0.1.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.1.12"
  }
}
